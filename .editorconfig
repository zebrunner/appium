# >>> mcloud-conventions: the shared part, changed in https://github.com/zebrunner/mcloud-conventions
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{js,mjs}]
indent_style = space
indent_size = 2

# shell scripts, also the style of shfmt
[*.sh]
indent_style = space
indent_size = 2
shell_variant = bash
space_redirects = true
# <<< mcloud-conventions

# shell scripts without the .sh extension
[{files/healthcheck,tests/fixtures/fake-adb}]
indent_style = space
indent_size = 2
shell_variant = bash
space_redirects = true

# generated: the patch diff and its build are kept byte for byte (tests/patch_sync_test.sh)
[files/patch/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
