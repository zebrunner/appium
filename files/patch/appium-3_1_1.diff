+
+// the shared file of the app of a url (see above) for the response of the url (its headers); null for a url that is
+// not http(s) or whose file name the storage cannot keep: such an app is downloaded for the session only, as Appium does
+async function getSharedApp(url: string, headers?: any): Promise<SharedApp | null> {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return null;
+  }
+  // the last path segment as the url has it: the dot segments are resolved by URL, a %2F stays in the name
+  const name = parsed.pathname.split('/').filter((segment) => segment !== '').pop();
+  if (!['http:', 'https:'].includes(parsed.protocol) || !parsed.host || !name || name === '.' || name === '..'
+    || RESERVED_NAME.test(name) || Buffer.byteLength(name) > MAX_NAME_LENGTH) {
+    return null;
+  }
+  let key: StoredAppKey = 'url';
+  let source = `url\n${parsed.href}`;
+  if (isSignedUrl(parsed) && isStrongEtag(headerValue(headers, 'etag'))) {
+    const params = [...parsed.searchParams.entries()]
+      .filter(([name]) => !SIGNATURE_PARAMS.has(name.toLowerCase()))
+      .map(([name, value]) => `${encodeURIComponent(name)}=${encodeURIComponent(value)}`)
+      .sort();
+    key = 'signed';
+    source = `signed\n${parsed.protocol}//${parsed.host}${parsed.pathname}?${params.join('&')}`;
+  }
+  const appsDir = path.resolve(await getLocalAppsFolder() as string);
+  const file = path.resolve(appsDir, parsed.host, sha256(source), name);
+  const relative = path.relative(appsDir, file);
+  if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) {
+    return null;
+  }
+  logger.info(`[MCLOUD] The file of the application in the shared storage (${key === 'signed' ? 'a signed url, keyed by its object' : 'keyed by its url'}): ${file}`);
+  return {file, key};
+}
+
+// the sha256 of a stored app: of the bytes of a file, of the names, the links and the bytes of the files of a folder
+// (the .app of a simulator)
+async function hashStoredApp(appPath: string): Promise<string> {
+  const hash = crypto.createHash('sha256');
+  const addFile = (file: string) => new Promise<void>((resolve, reject) => {
+    createReadStream(file).on('data', (chunk) => hash.update(chunk)).on('end', () => resolve()).on('error', reject);
+  });
+  const stats = await nodeFs.lstat(appPath);
+  if (!stats.isDirectory()) {
+    await addFile(appPath);
+    return hash.digest('hex');
+  }
+  const walk = async (dir: string, prefix: string) => {
+    const entries = (await nodeFs.readdir(dir, {withFileTypes: true})).sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
+    for (const entry of entries) {
+      const full = path.join(dir, entry.name);
+      const relative = `${prefix}${entry.name}`;
+      if (entry.isDirectory()) {
+        hash.update(`D\0${relative}\0`);
+        await walk(full, `${relative}/`);
+      } else if (entry.isSymbolicLink()) {
+        hash.update(`L\0${relative}\0${await nodeFs.readlink(full)}\0`);
+      } else if (entry.isFile()) {
+        hash.update(`F\0${relative}\0${(await nodeFs.stat(full)).size}\0`);
+        await addFile(full);
+      }
+    }
+  };
+  await walk(appPath, '');
+  return hash.digest('hex');
+}
+
+// the metadata of a stored app, null when missing or invalid
+async function readStoredAppMeta(file: string): Promise<StoredAppMeta | null> {
+  try {
+    const meta = JSON.parse(await nodeFs.readFile(`${file}${STORED_APP_META}`, 'utf8'));
+    if (meta && ['url', 'signed'].includes(meta.key) && typeof meta.sha256 === 'string' && /^[0-9a-f]{64}$/.test(meta.sha256)) {
+      return {
+        key: meta.key,
+        etag: typeof meta.etag === 'string' ? meta.etag : null,
+        lastModified: typeof meta.lastModified === 'string' ? meta.lastModified : null,
+        contentLength: Number.isSafeInteger(meta.contentLength) ? meta.contentLength : null,
+        sha256: meta.sha256,
+      };
+    }
+  } catch {
+    // no metadata (e.g. an app of an older image) or a broken one
+  }
+  return null;
+}
+
+// writes the metadata of the app copied to tmpPath (the response headers of its download) next to its file: the
+// metadata is written beside it and renamed, the caller renames the app into place (it holds the .lock of the download)
+async function writeStoredAppMeta(file: string, tmpPath: string, key: StoredAppKey, headers: any) {
+  const meta: StoredAppMeta = {
+    key,
+    etag: headerValue(headers, 'etag'),
+    lastModified: headerValue(headers, 'last-modified'),
+    contentLength: contentLength(headers),
+    sha256: await hashStoredApp(tmpPath),
+  };
+  const metaFile = `${file}${STORED_APP_META}`;
+  const metaTmp = `${metaFile}.${process.pid}.tmp`;
+  try {
+    await nodeFs.writeFile(metaTmp, JSON.stringify(meta));
+    await nodeFs.rename(metaTmp, metaFile);
+  } finally {
+    await nodeFs.rm(metaTmp, {force: true});
+  }
+}
+
+// whether the stored app can be used for the url of the session whose response has the headers: the metadata of the
+// app is the one of its key, the response is the same app (the same strong ETag, or else the same Last-Modified and
+// Content-Length, or else the same Content-Length for the key of the url; for a signed url only the ETag), and the
+// bytes of the stored app are the ones it was downloaded with. trustStored (APPIUM_APP_SIZE_DISABLE=true) skips the
+// comparison with the response for the key of the url (the app was downloaded from the same url), not the sha256.
+async function checkStoredApp(app: SharedApp, headers: any, trustStored = false): Promise<{ok: boolean, reason: string}> {
+  const meta = await readStoredAppMeta(app.file);
+  if (!meta) {
+    return {ok: false, reason: 'it has no metadata'};
+  }
+  if (meta.key !== app.key) {
+    return {ok: false, reason: `its metadata is of another key (${meta.key})`};
+  }
+  const etag = headerValue(headers, 'etag');
+  const lastModified = headerValue(headers, 'last-modified');
+  const length = contentLength(headers);
+  let validated: string;
+  if (app.key === 'signed') {
+    if (!isStrongEtag(etag) || etag !== meta.etag) {
+      return {ok: false, reason: `the ETag of the response (${etag}) is not the one of the stored app (${meta.etag})`};
+    }
+    validated = `the same ETag ${etag}`;
+  } else if (trustStored) {
+    validated = 'APPIUM_APP_SIZE_DISABLE=true: the response is not compared';
+  } else if (etag !== null && meta.etag !== null) {
+    if (etag !== meta.etag) {
+      return {ok: false, reason: `the ETag of the response (${etag}) is not the one of the stored app (${meta.etag})`};
+    }
+    validated = `the same ETag ${etag}`;
+  } else if (lastModified !== null && meta.lastModified !== null) {
+    if (lastModified !== meta.lastModified || (length !== null && length !== meta.contentLength)) {
+      return {ok: false, reason: `the Last-Modified and Content-Length of the response (${lastModified}, ${length}) are not the ones of the stored app (${meta.lastModified}, ${meta.contentLength})`};
+    }
+    validated = `the same Last-Modified ${lastModified}`;
+  } else if (length !== null && meta.contentLength !== null) {
+    if (length !== meta.contentLength) {
+      return {ok: false, reason: `the Content-Length of the response (${length}) is not the one of the stored app (${meta.contentLength})`};
+    }
+    validated = `the same Content-Length ${length}`;
+  } else {
+    return {ok: false, reason: 'the response has no ETag, Last-Modified or Content-Length to compare with the stored app'};
+  }
+  let actual: string;
+  try {
+    actual = await hashStoredApp(app.file);
+  } catch (err) {
+    return {ok: false, reason: `it cannot be read: ${toError(err).message}`};
+  }
+  if (actual !== meta.sha256) {
+    return {ok: false, reason: 'its sha256 is not the one it was downloaded with'};
+  }
+  return {ok: true, reason: `${validated}, the same sha256`};
+}
+
+// the folder of the shared file of an app, created when missing
+async function getSharedFolder(app: SharedApp) {
+  const targetPath = path.dirname(app.file);
+  if (!await fs.exists(targetPath)) {
+    await fs.mkdir(targetPath, {recursive: true});
+  }
+  return targetPath;
+}
+
+async function executeShell(shellCommand, description) {
+  const execPromisify = util.promisify(exec);
+  try {
+    const { stderr } = await execPromisify(shellCommand);
+    if (stderr) {
+      logger.info(`[MCLOUD] ${description} stderr: ${stderr}`);
+      return;
+    }
+    logger.info(`[MCLOUD] ${description} command was successfully executed`);
+  } catch (error) {
+    logger.info(`[MCLOUD] ${description} error: ${error.message}`);
+    return;
+  }
+}
+
+// timeoutMs: the command is killed and the promise rejected after it (0: no limit)
+async function executeShellWPromise(shellCommand, timeoutMs = 0) {
+  const execPromisify = util.promisify(exec);
+  return await execPromisify(shellCommand, {timeout: timeoutMs});
+}
+
+async function parseWDAUrl() {
+  const wdaHost = process.env.WDA_HOST;
+  const wdaPort = process.env.WDA_PORT;
+  return `http://${wdaHost}:${wdaPort}/status`;
+}
+
+// [MCLOUD] WebDriverAgent busy with the end of the last session answers its status in more than 500 ms: a status
+// check of mcloud-grid then made Appium exit (and its container restart). A slow WDA gets 3 s and a second attempt;
+// mcloud-grid waits 10 s for the status check.
+const WDA_STATUS_TIMEOUT_MS = 3000;
+const WDA_STATUS_RETRY_DELAY_MS = 500;
+
+async function getWDAStatus(wdaURL, attempts = 2) {
+  for (let attempt = 1; attempt <= attempts; attempt++) {
+    try {
+      return (await axios({
+        url: wdaURL,
+        method: 'GET',
+        timeout: WDA_STATUS_TIMEOUT_MS,
+      })).data;
+    } catch (e) {
+      logger.info(`[MCLOUD] Cannot send GET request to '${wdaURL}' (attempt ${attempt} of ${attempts}). Original error: ${e.message}`);
+      if (attempt < attempts) {
+        await new Promise((resolve) => setTimeout(resolve, WDA_STATUS_RETRY_DELAY_MS));
+      }
+    }
+  }
+  return undefined;
+}
+
+export {
+  toError,
+  isInSharedStorage,
+  touchSharedApp,
+  evictSharedApps,
+  getLocalAppsFolder,
+  getSharedApp,
+  getSharedFolder,
+  checkStoredApp,
+  writeStoredAppMeta,
+  hashStoredApp,
+  executeShell,
+  executeShellWPromise,
+  parseWDAUrl,
+  getWDAStatus
+};
