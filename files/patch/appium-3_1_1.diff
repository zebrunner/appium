@@ -0,0 +1,322 @@
+import {fs} from '@appium/support';
+import * as path from 'path';
+import axios from 'axios';
+import logger from './logger';
+import util from 'util';
+import { exec } from 'child_process';
+import { promises as nodeFs } from 'fs';
+import {
+  type ResponseType
+  } from 'axios';
+
+async function getLocalAppsFolder() {
+  if (process.env.APPIUM_APPS_DIR === undefined || process.env.APPIUM_APPS_DIR === '') {
+    return undefined;
+  } else {
+    return process.env.APPIUM_APPS_DIR;
+  }
+}
+
+// whether the path is in the shared application storage (APPIUM_APPS_DIR): those files are kept for all the
+// Appium of the host and must not be removed by the cleanup of the cached applications
+function isInSharedStorage(fullPath?: string): boolean {
+  const appsDir = process.env.APPIUM_APPS_DIR;
+  if (!appsDir || !fullPath) {
+    return false;
+  }
+  const relative = path.relative(path.resolve(appsDir), path.resolve(fullPath));
+  return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);
+}
+
+// [MCLOUD] the shared storage keeps the apps of all the devices of the host and nothing removed them: every build
+// of an app is a new url, so the storage grew until the disk of the host was full. Before a download the apps not
+// used for APPIUM_APPS_MAX_AGE days are removed, then the least recently used ones while the free space of the
+// storage is below APPIUM_APPS_MIN_FREE percent; the apps used in the last hour and the ones being downloaded (.lock)
+// are kept. An app is used when a session takes it from the storage (its mtime, touchSharedApp).
+const DAY_MS = 24 * 60 * 60 * 1000;
+const RECENTLY_USED_MS = 60 * 60 * 1000;
+const TEMPORARY_COPY = /\.\d+\.tmp$/;
+
+interface StoredFile {
+  file: string;
+  size: number;
+  mtimeMs: number;
+}
+
+// a non-negative number of the env var, the default otherwise
+function nonNegativeEnv(name: string, defaultValue: number): number {
+  const raw = process.env[name];
+  const value = raw === undefined || raw.trim() === '' ? NaN : Number(raw);
+  if (Number.isFinite(value) && value >= 0) {
+    return value;
+  }
+  if (raw !== undefined && raw.trim() !== '') {
+    logger.warn(`[MCLOUD] ${name}='${raw}' is not a non-negative number, ${defaultValue} is used`);
+  }
+  return defaultValue;
+}
+
+// marks the app of the shared storage as used now, so that the eviction keeps it
+async function touchSharedApp(file: string) {
+  const now = new Date();
+  try {
+    await nodeFs.utimes(file, now, now);
+  } catch (err) {
+    logger.warn(`[MCLOUD] Cannot mark the application ${file} as used: ${toError(err).message}`);
+  }
+}
+
+// the apps of the shared storage (not the .lock files) whose download is not running, and the temporary copies
+async function listStoredFiles(dir: string): Promise<{apps: StoredFile[], temporary: StoredFile[]}> {
+  const apps: StoredFile[] = [];
+  const temporary: StoredFile[] = [];
+  let entries;
+  try {
+    entries = await nodeFs.readdir(dir, {withFileTypes: true});
+  } catch (err) {
+    if (err.code === 'ENOENT') {
+      return {apps, temporary};
+    }
+    throw err;
+  }
+  const names = new Set(entries.map((entry) => entry.name));
+  for (const entry of entries) {
+    const file = path.join(dir, entry.name);
+    if (entry.isDirectory()) {
+      const nested = await listStoredFiles(file);
+      apps.push(...nested.apps);
+      temporary.push(...nested.temporary);
+      continue;
+    }
+    if (!entry.isFile() || entry.name.endsWith('.lock') || names.has(`${entry.name}.lock`)) {
+      continue;
+    }
+    let stats;
+    try {
+      stats = await nodeFs.stat(file);
+    } catch {
+      // removed by another Appium meanwhile
+      continue;
+    }
+    (TEMPORARY_COPY.test(entry.name) ? temporary : apps).push({file, size: stats.size, mtimeMs: stats.mtimeMs});
+  }
+  return {apps, temporary};
+}
+
+async function removeStoredFile(stored: StoredFile, reason: string): Promise<boolean> {
+  try {
+    await nodeFs.rm(stored.file, {force: true});
+    logger.info(`[MCLOUD] Removed ${stored.file} (${stored.size} bytes) from the shared storage: ${reason}`);
+    return true;
+  } catch (err) {
+    logger.warn(`[MCLOUD] Cannot remove ${stored.file} from the shared storage: ${toError(err).message}`);
+    return false;
+  }
+}
+
+// the eviction of the shared storage, see above; it never fails the session
+async function evictSharedApps(appsDir: string, now = Date.now()) {
+  try {
+    const maxAgeDays = nonNegativeEnv('APPIUM_APPS_MAX_AGE', 7);
+    const minFreePercent = nonNegativeEnv('APPIUM_APPS_MIN_FREE', 10);
+    const {apps, temporary} = await listStoredFiles(appsDir);
+    // the copies of the downloads interrupted by the end of their Appium
+    for (const stored of temporary) {
+      if (now - stored.mtimeMs > RECENTLY_USED_MS) {
+        await removeStoredFile(stored, 'an interrupted download');
+      }
+    }
+    let unused = apps.filter((stored) => now - stored.mtimeMs > RECENTLY_USED_MS);
+    if (maxAgeDays > 0) {
+      const expired = unused.filter((stored) => now - stored.mtimeMs > maxAgeDays * DAY_MS);
+      for (const stored of expired) {
+        await removeStoredFile(stored, `not used for ${maxAgeDays} days (APPIUM_APPS_MAX_AGE)`);
+      }
+      unused = unused.filter((stored) => !expired.includes(stored));
+    }
+    if (minFreePercent > 0) {
+      const {bavail, blocks, bsize} = await nodeFs.statfs(appsDir);
+      const needed = blocks * bsize * minFreePercent / 100;
+      let free = bavail * bsize;
+      // the least recently used first
+      for (const stored of unused.sort((a, b) => a.mtimeMs - b.mtimeMs)) {
+        if (free >= needed) {
+          break;
+        }
+        if (await removeStoredFile(stored, `the free space of the storage is below ${minFreePercent}% (APPIUM_APPS_MIN_FREE)`)) {
+          free += stored.size;
+        }
+      }
+      if (free < needed) {
+        logger.warn(`[MCLOUD] The free space of the shared storage ${appsDir} stays below ${minFreePercent}% (APPIUM_APPS_MIN_FREE): `
+          + `the other apps were used in the last hour or are being downloaded`);
+      }
+    }
+  } catch (err) {
+    logger.warn(`[MCLOUD] The eviction of the shared storage ${appsDir} failed: ${toError(err).message}`);
+  }
+}
+
+// the error as an Error with a string message: not every rejection is an Error, e.g. fs.copyFile of
+// @appium/support rejects with an array of errors (ncp), and the MCloud error handling reads err.message
+function toError(err: any): Error {
+  if (Array.isArray(err)) {
+    return new Error(err.map((e) => (e instanceof Error ? e.message : String(e))).join('; '));
+  }
+  if (err instanceof Error) {
+    if (typeof err.message !== 'string') {
+      err.message = String(err.message ?? '');
+    }
+    return err;
+  }
+  return new Error(typeof err === 'string' ? err : `${err}`);
+}
+
+// the folder of the shared storage for the app of a url (getLocalFileForAppUrl), created when missing
+async function getSharedFolderForAppUrl(url) {
+  const localFile = await getLocalFileForAppUrl(url);
+  if (!localFile) {
+    throw new Error(`[MCLOUD] The application url has no file in the shared storage: ${url}`);
+  }
+  const targetPath = path.dirname(localFile);
+
+  logger.info(`[MCLOUD] Target path [getSharedFolderForAppUrl]: ${targetPath}`);
+  const folderExists = await fs.exists(targetPath);
+  if (!folderExists) {
+    await fs.mkdir(targetPath, {recursive: true});
+  }
+  return targetPath;
+}
+
+exports.getSharedFolderForAppUrl = getSharedFolderForAppUrl;
+
+// the file of the shared storage (APPIUM_APPS_DIR) for the app of a url: <host>/<path> of the url without its query
+// (the signed urls of S3 and App Center change on every request). The host keeps apart the apps of different servers,
+// the storage is shared by every device of the host; null for a url that is not http(s), has no path or leaves the
+// storage: such an app is downloaded for the session only, as Appium does
+async function getLocalFileForAppUrl(url): Promise<string | null> {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return null;
+  }
+  // the path segments as the url has them: the dot segments are resolved by URL, a %2F stays in its file name
+  const segments = parsed.pathname.split('/').filter((segment) => segment !== '');
+  if (!['http:', 'https:'].includes(parsed.protocol) || !parsed.host || !segments.length
+    || segments.some((segment) => segment === '.' || segment === '..')) {
+    return null;
+  }
+  const appsDir = path.resolve(await getLocalAppsFolder() as string);
+  const targetPath = path.resolve(appsDir, parsed.host, ...segments);
+  const relative = path.relative(appsDir, targetPath);
+  if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) {
+    return null;
+  }
+  logger.info(`[MCLOUD] Target path [getLocalFileForAppUrl]: ${targetPath}`);
+  return targetPath;
+}
+
+async function getFileContentLength(remoteUrl) {
+  const timeout = 10000;
+  const retries = 5;
+  const pollingInterval = 3000;
+
+  const requestOpts = {
+    url: remoteUrl,
+    responseType: 'stream' as ResponseType,
+    timeout,
+  };
+
+  // getting content-length with retry
+  let lastError;
+  const getLengthRequest = async () => {
+    for (let i = 0; i < retries; i++) {
+      try {
+        logger.debug(`[MCLOUD] Making GET http call for retrieving of remote app size`);
+        const {
+          headers: responseHeaders,
+        } = await axios(requestOpts);
+        const responseLength = parseInt(responseHeaders['content-length'], 10);
+        logger.debug(`[MCLOUD] CONTENT-LENGTH for the file: ${responseLength}`);
+        return responseLength;
+      } catch (error) {
+        lastError = error;
+        logger.warn(`[MCLOUD] Cannot fetch info about app size. Will retry attempt in ${pollingInterval}ms`);
+        await new Promise((resolve) => setTimeout(resolve, pollingInterval));
+      }
+    }
+  };
+  const length = await getLengthRequest();
+  if (length) {
+    return length;
+  } else {
+    throw new Error(`[MCLOUD] Cannot get file content-length from ${remoteUrl} after ${retries} retry(s): ${lastError}`);
+  }
+}
+
+async function executeShell(shellCommand, description) {
+  const execPromisify = util.promisify(exec);
+  try {
+    const { stderr } = await execPromisify(shellCommand);
+    if (stderr) {
+      logger.info(`[MCLOUD] ${description} stderr: ${stderr}`);
+      return;
+    }
+    logger.info(`[MCLOUD] ${description} command was successfully executed`);
+  } catch (error) {
+    logger.info(`[MCLOUD] ${description} error: ${error.message}`);
+    return;
+  }
+}
+
+// timeoutMs: the command is killed and the promise rejected after it (0: no limit)
+async function executeShellWPromise(shellCommand, timeoutMs = 0) {
+  const execPromisify = util.promisify(exec);
+  return await execPromisify(shellCommand, {timeout: timeoutMs});
+}
+
+async function parseWDAUrl() {
+  const wdaHost = process.env.WDA_HOST;
+  const wdaPort = process.env.WDA_PORT;
+  return `http://${wdaHost}:${wdaPort}/status`;
+}
+
+// [MCLOUD] WebDriverAgent busy with the end of the last session answers its status in more than 500 ms: a status
+// check of mcloud-grid then made Appium exit (and its container restart). A slow WDA gets 3 s and a second attempt;
+// mcloud-grid waits 10 s for the status check.
+const WDA_STATUS_TIMEOUT_MS = 3000;
+const WDA_STATUS_RETRY_DELAY_MS = 500;
+
+async function getWDAStatus(wdaURL, attempts = 2) {
+  for (let attempt = 1; attempt <= attempts; attempt++) {
+    try {
+      return (await axios({
+        url: wdaURL,
+        method: 'GET',
+        timeout: WDA_STATUS_TIMEOUT_MS,
+      })).data;
+    } catch (e) {
+      logger.info(`[MCLOUD] Cannot send GET request to '${wdaURL}' (attempt ${attempt} of ${attempts}). Original error: ${e.message}`);
+      if (attempt < attempts) {
+        await new Promise((resolve) => setTimeout(resolve, WDA_STATUS_RETRY_DELAY_MS));
+      }
+    }
+  }
+  return undefined;
+}
+
+export {
+  toError,
+  isInSharedStorage,
+  touchSharedApp,
+  evictSharedApps,
+  getLocalAppsFolder,
+  getSharedFolderForAppUrl,
+  getLocalFileForAppUrl,
+  getFileContentLength,
+  executeShell,
+  executeShellWPromise,
+  parseWDAUrl,
+  getWDAStatus
+};
