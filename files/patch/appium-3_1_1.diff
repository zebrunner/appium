+      apps.push(...nested.apps);
+      temporary.push(...nested.temporary);
+      continue;
+    }
+    let stored;
+    try {
+      stored = {file, size: await storedSize(file), mtimeMs: (await nodeFs.stat(file)).mtimeMs};
+    } catch {
+      // removed by another Appium meanwhile
+      continue;
+    }
+    (isTemporary || entry.name.endsWith(STORED_APP_META) ? temporary : apps).push(stored);
+  }
